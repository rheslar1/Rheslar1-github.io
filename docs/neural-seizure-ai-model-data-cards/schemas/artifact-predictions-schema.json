{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactPredictions",
  "type": "object",
  "required": [
    "predictions"
  ],
  "properties": {
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "probability",
          "predicted_preictal",
          "rationale",
          "model"
        ],
        "properties": {
          "model": { "type": "string" },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "predicted_preictal": { "type": "boolean" },
          "rationale": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

